# RouteAI ortam değişkenleri şablonu.
# Kullanım: cp .env.local.example .env.local  → değerleri .env.local içinde doldur.
# Bu dosyaya gerçek anahtar YAZMA; repoya giriyor. Açıklamalar README'deki tabloda.

# OpenAI
OPENAI_API_KEY=
# Sohbet ajanının modeli; boşsa gpt-4o-mini (lib/agent/config.ts)
OPENAI_MODEL=
# Aylık token bütçesi (sohbet ajanı). Aşılınca v1 anahtar kelime yoluna düşülür. Boş = sınır yok
OPENAI_MONTHLY_TOKEN_BUDGET=

# Upstash Vector (sadece VECTOR_SEARCH_ENABLED=true iken kullanılır)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# 'true' yazılırsa vektör araması açılır; boş/tanımsız = kapalı (anahtar kelime araması)
VECTOR_SEARCH_ENABLED=

# Vercel KV (Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# Admin uçları (/api/admin/*, /api/update-tools) — x-admin-key başlığıyla gönderilir
ADMIN_SECRET=

# Artificial Analysis API anahtarı — gece model senkronu (npm run sync:models); boşsa AA atlanır
AA_API_KEY=

# Uygulamanın taban URL'i (isteğe bağlı)
NEXT_PUBLIC_BASE_URL=
