# RouteAI ortam değişkenleri şablonu.
# Kullanım: cp .env.local.example .env.local  → değerleri .env.local içinde doldur.
# Bu dosyaya gerçek anahtar YAZMA; repoya giriyor. Açıklamalar README'deki tabloda.

# OpenAI
OPENAI_API_KEY=
# Varsayılan model (prompt oluşturucu OPENAI_PROMPT_MODEL boşsa bunu kullanır); boşsa gpt-4o-mini (lib/agent/config.ts)
OPENAI_MODEL=
# Prompt oluşturucunun modeli (/api/prompt/*, build_prompt); boşsa OPENAI_MODEL, o da boşsa gpt-4o-mini
OPENAI_PROMPT_MODEL=
# Aylık token bütçesi (prompt oluşturucu). Aşılınca prompt oluşturucu 503 döner. Boş = sınır yok
OPENAI_MONTHLY_TOKEN_BUDGET=

# Upstash Vector (sadece VECTOR_SEARCH_ENABLED=true iken kullanılır)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# 'true' yazılırsa vektör araması açılır; boş/tanımsız = kapalı (anahtar kelime araması)
VECTOR_SEARCH_ENABLED=

# Vercel KV (Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
# Vercel KV entegrasyonu bu ikisini de ekler; kod kullanmaz (@vercel/kv REST değişkenlerini okur)
KV_URL=
REDIS_URL=

# Admin uçları (/api/admin/*, /api/update-tools) — x-admin-key başlığıyla gönderilir
ADMIN_SECRET=

# Artificial Analysis API anahtarı — gece model senkronu (npm run sync:models); boşsa AA atlanır
AA_API_KEY=

# Product Hunt API token'ı — haftalık keşif (npm run discover:tools); boşsa sadece Hacker News taranır
PRODUCT_HUNT_TOKEN=

# Uygulamanın taban URL'i (isteğe bağlı; boşsa https://www.routeai.chat)
NEXT_PUBLIC_BASE_URL=

# Gizlilik sayfasında gösterilecek iletişim e-postası (isteğe bağlı; boşsa iletişim satırı çıkmaz)
NEXT_PUBLIC_CONTACT_EMAIL=
